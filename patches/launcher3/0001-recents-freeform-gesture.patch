+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.quickstep.util;
+
+import static com.android.launcher3.util.Executors.MAIN_EXECUTOR;
+import static com.android.launcher3.util.VibratorWrapper.OVERVIEW_HAPTIC;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.UserHandle;
+
+import androidx.annotation.Nullable;
+
+import com.android.launcher3.LauncherPrefs;
+import com.android.launcher3.LauncherPrefsExt;
+import com.android.launcher3.util.VibratorWrapper;
+import com.android.quickstep.SystemUiProxy;
+import com.android.quickstep.views.TaskView;
+import com.android.systemui.shared.recents.model.Task;
+import com.android.wm.shell.shared.bubbles.BubbleAnythingFlagHelper;
+import com.android.wm.shell.shared.bubbles.logging.EntryPoint;
+
+/**
+ * Swipe up from an app and keep dragging past a threshold: on release the app
+ * opens as an app bubble instead of going home or to recents.
+ */
+public final class RecentsFreeformGesture {
+
+    private final Context mContext;
+    private final boolean mEnabled;
+    private final float mThreshold;
+    private boolean mPastThreshold;
+
+    public RecentsFreeformGesture(Context context) {
+        mContext = context;
+        // App bubbles need the shell "create any bubble" feature
+        LauncherPrefs prefs = LauncherPrefs.get(context);
+        mEnabled = prefs.get(LauncherPrefsExt.RECENTS_FREEFORM_GESTURE)
+                && BubbleAnythingFlagHelper.enableCreateAnyBubble();
+        mThreshold = prefs.get(LauncherPrefsExt.RECENTS_FREEFORM_THRESHOLD) / 100f;
+    }
+
+    public boolean isEnabled() {
+        return mEnabled;
+    }
+
+    /**
+     * @param shift            current swipe progress (0 = app, 1 = overview)
+     * @param dragLengthFactor the shift value when the finger reaches the top of the screen
+     */
+    public boolean isPastThreshold(float shift, float dragLengthFactor) {
+        return mEnabled && dragLengthFactor > 0 && shift / dragLengthFactor >= mThreshold;
+    }
+
+    /** Vibrates once each time the swipe crosses the threshold, so the user knows. */
+    public void onShiftUpdated(float shift, float dragLengthFactor, boolean gestureOngoing) {
+        if (!mEnabled) return;
+        boolean past = gestureOngoing && isPastThreshold(shift, dragLengthFactor);
+        if (past && !mPastThreshold) {
+            VibratorWrapper.INSTANCE.get(mContext).vibrate(OVERVIEW_HAPTIC);
+        }
+        mPastThreshold = past;
+    }
+
+    /** The single task under the swipe, or null if this gesture cannot float it. */
+    @Nullable
+    public static Task getFloatableTask(@Nullable TaskView runningTaskView) {
+        if (runningTaskView == null || runningTaskView.getTaskContainers().size() != 1) {
+            return null;
+        }
+        Task task = runningTaskView.getFirstTask();
+        if (task == null || task.key == null || task.key.getComponent() == null) {
+            return null;
+        }
+        return task;
+    }
+
+    /** Opens the task as an app bubble. */
+    public void launch(Task task) {
+        Intent intent = mContext.getPackageManager()
+                .getLaunchIntentForPackage(task.key.getPackageName());
+        if (intent == null) {
+            intent = new Intent(Intent.ACTION_MAIN)
+                    .addCategory(Intent.CATEGORY_LAUNCHER)
+                    .setComponent(task.key.getComponent());
+        }
+        Intent bubbleIntent = intent;
+        UserHandle user = UserHandle.of(task.key.userId);
+        MAIN_EXECUTOR.execute(() -> SystemUiProxy.INSTANCE.get(mContext).showAppBubble(
+                bubbleIntent, user, EntryPoint.TASKBAR_ICON_MENU, null));
+    }
+}
