diff --git a/quickstep/src/com/android/quickstep/util/RecentsFreeformGesture.java b/quickstep/src/com/android/quickstep/util/RecentsFreeformGesture.java
new file mode 100644
index 0000000..9f0fac9
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/util/RecentsFreeformGesture.java
@@ -0,0 +1,184 @@
