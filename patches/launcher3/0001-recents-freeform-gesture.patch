+package com.android.quickstep.util;
+
+import static android.app.WindowConfiguration.WINDOWING_MODE_FREEFORM;
+
+import static com.android.launcher3.util.Executors.MAIN_EXECUTOR;
+import static com.android.launcher3.util.Executors.UI_HELPER_EXECUTOR;
+import static com.android.launcher3.util.VibratorWrapper.OVERVIEW_HAPTIC;
+
+import android.app.ActivityOptions;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Rect;
+import android.os.UserHandle;
+import android.util.DisplayMetrics;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+import com.android.launcher3.LauncherPrefs;
+import com.android.launcher3.util.VibratorWrapper;
+import com.android.quickstep.SystemUiProxy;
+import com.android.quickstep.views.TaskView;
+import com.android.systemui.shared.recents.model.Task;
+import com.android.systemui.shared.system.ActivityManagerWrapper;
+import com.android.wm.shell.shared.bubbles.logging.EntryPoint;
+
+/**
+ * Swipe up from an app and keep dragging past a threshold: on release the app
+ * opens as a floating window instead of going home or to recents.
+ */
+public final class RecentsFreeformGesture {
+
+    private static final String TAG = "RecentsFreeformGesture";
+
+    /** Native freeform window (ActivityOptions windowing mode). */
+    public static final int METHOD_NATIVE = 0;
+    /** LMOFreeform app (follows its own native/LMO launch mode setting). */
+    public static final int METHOD_LMO = 1;
+    /** App bubble from SystemUI. */
+    public static final int METHOD_BUBBLE = 2;
+
+    private static final int DEFAULT_THRESHOLD_PERCENT = 60;
+    private static final int DEFAULT_METHOD = METHOD_LMO;
+
+    private static final String LMO_PACKAGE = "com.libremobileos.freeform";
+    private static final String LMO_ACTION = "com.libremobileos.freeform.START_FREEFORM";
+
+    private final Context mContext;
+    private final boolean mEnabled;
+    private final float mThreshold;
+    private final int mMethod;
+    private boolean mPastThreshold;
+
+    public RecentsFreeformGesture(Context context) {
+        mContext = context;
+        mEnabled = LauncherPrefs.RECENTS_FREEFORM_GESTURE.get(context);
+        mThreshold = parseInt(LauncherPrefs.RECENTS_FREEFORM_THRESHOLD.get(context),
+                DEFAULT_THRESHOLD_PERCENT) / 100f;
+        mMethod = parseInt(LauncherPrefs.RECENTS_FREEFORM_METHOD.get(context), DEFAULT_METHOD);
+    }
+
+    private static int parseInt(@Nullable String value, int fallback) {
+        if (value == null) return fallback;
+        try {
+            return Integer.parseInt(value);
+        } catch (NumberFormatException e) {
+            return fallback;
+        }
+    }
+
+    public boolean isEnabled() {
+        return mEnabled;
+    }
+
+    /**
+     * @param shift            current swipe progress (0 = app, 1 = overview)
+     * @param dragLengthFactor the shift value when the finger reaches the top of the screen
+     */
+    public boolean isPastThreshold(float shift, float dragLengthFactor) {
+        return mEnabled && dragLengthFactor > 0 && shift / dragLengthFactor >= mThreshold;
+    }
+
+    /** Vibrates once each time the swipe crosses the threshold, so the user knows. */
+    public void onShiftUpdated(float shift, float dragLengthFactor, boolean gestureOngoing) {
+        if (!mEnabled) return;
+        boolean past = gestureOngoing && isPastThreshold(shift, dragLengthFactor);
+        if (past && !mPastThreshold) {
+            VibratorWrapper.INSTANCE.get(mContext).vibrate(OVERVIEW_HAPTIC);
+        }
+        mPastThreshold = past;
+    }
+
+    /** The single task under the swipe, or null if this gesture cannot float it. */
+    @Nullable
+    public static Task getFloatableTask(@Nullable TaskView runningTaskView) {
+        if (runningTaskView == null || runningTaskView.getTaskContainers().size() != 1) {
+            return null;
+        }
+        Task task = runningTaskView.getFirstTask();
+        if (task == null || task.key == null || task.key.getComponent() == null) {
+            return null;
+        }
+        return task;
+    }
+
+    /** Opens the task as a floating window with the chosen method. */
+    public void launch(Task task) {
+        switch (mMethod) {
+            case METHOD_NATIVE:
+                launchNative(task);
+                break;
+            case METHOD_BUBBLE:
+                launchBubble(task);
+                break;
+            case METHOD_LMO:
+            default:
+                launchLmo(task);
+                break;
+        }
+    }
+
+    private void launchNative(Task task) {
+        DisplayMetrics dm = mContext.getResources().getDisplayMetrics();
+        int w = Math.round(dm.widthPixels * 0.8f);
+        int h = Math.round(dm.heightPixels * 0.5f);
+        int left = (dm.widthPixels - w) / 2;
+        int top = (dm.heightPixels - h) / 2;
+        ActivityOptions options = ActivityOptions.makeBasic();
+        options.setLaunchWindowingMode(WINDOWING_MODE_FREEFORM);
+        options.setLaunchBounds(new Rect(left, top, left + w, top + h));
+        int taskId = task.key.id;
+        UI_HELPER_EXECUTOR.execute(() -> {
+            if (!ActivityManagerWrapper.getInstance().startActivityFromRecents(taskId, options)) {
+                Log.w(TAG, "Native freeform launch failed for task " + taskId);
+            }
+        });
+    }
+
+    private void launchLmo(Task task) {
+        ComponentName component = task.topActivity != null
+                ? task.topActivity : task.key.getComponent();
+        Intent intent = new Intent(LMO_ACTION)
+                .setPackage(LMO_PACKAGE)
+                .putExtra("packageName", component.getPackageName())
+                .putExtra("activityName", component.getClassName())
+                .putExtra("userId", task.key.userId)
+                .putExtra("taskId", task.key.id);
+        try {
+            mContext.sendBroadcast(intent);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "LMOFreeform broadcast failed", e);
+        }
+    }
+
+    private void launchBubble(Task task) {
+        Intent intent = mContext.getPackageManager()
+                .getLaunchIntentForPackage(task.key.getPackageName());
+        if (intent == null) {
+            intent = new Intent(Intent.ACTION_MAIN)
+                    .addCategory(Intent.CATEGORY_LAUNCHER)
+                    .setComponent(task.key.getComponent());
+        }
+        Intent bubbleIntent = intent;
+        UserHandle user = UserHandle.of(task.key.userId);
+        MAIN_EXECUTOR.execute(() -> SystemUiProxy.INSTANCE.get(mContext).showAppBubble(
+                bubbleIntent, user, EntryPoint.TASKBAR_ICON_MENU, null));
+    }
+}
