 audio_route/Android.bp       |   7 +++++--
 audio_route/libaudioroute.so | Bin 0 -> 19376 bytes
 2 files changed, 5 insertions(+), 2 deletions(-)
 create mode 100644 audio_route/libaudioroute.so

diff --git a/audio_route/Android.bp b/audio_route/Android.bp
index fbe23aad..ddee86c1 100644
--- a/audio_route/Android.bp
+++ b/audio_route/Android.bp
@@ -10,7 +10,6 @@ cc_defaults {
     name: "libaudioroute_defaults",
     vendor_available: true,
     host_supported: true,
-    srcs: ["audio_route.c"],
     export_include_dirs: ["include"],
     shared_libs: [
         "libcutils",
@@ -24,9 +23,12 @@ cc_defaults {
     ],
 }
 
-cc_library_shared {
+cc_prebuilt_library_shared {
     name: "libaudioroute",
     defaults: ["libaudioroute_defaults"],
+    srcs: [
+        "libaudioroute.so",
+    ],
     shared_libs: [
         "libtinyalsa",
     ],
@@ -35,6 +37,7 @@ cc_library_shared {
 cc_library_shared {
     name: "libaudioroutev2",
     defaults: ["libaudioroute_defaults"],
+    srcs: ["audio_route.c"],
     shared_libs: [
         "libtinyalsav2",
     ],
diff --git a/audio_route/libaudioroute.so b/audio_route/libaudioroute.so
new file mode 100644
