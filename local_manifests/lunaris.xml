<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lunaris-AOSP 16.2 (Android 16 QPR2, berbasis LineageOS 23.2) untuk POCO F4 GT / Redmi K50 Gaming (ingres).
    Taruh di .repo/local_manifests/lunaris.xml - dipasang otomatis oleh build-lunaris.sh.

    Device, vendor, dan kernel ingres memakai branch yang sama dengan LineageOS 24
    (OS2.0.8.0.ULJCNXM, tanpa firmware); device common, vendor common, dan
    hardware/xiaomi memakai lineage-23.2 agar cocok dengan basis Lunaris.
-->
<manifest>
  <remote name="d2n" fetch="https://github.com/kingD2N" />
  <remote name="los" fetch="https://github.com/LineageOS" />
  <remote name="muppets" fetch="https://github.com/TheMuppets" />

  <!-- Device // ingres -->
  <project name="android_device_xiaomi_ingres-old" path="device/xiaomi/ingres" remote="d2n" revision="lunaris-16.2" />
  <!-- Device // common -->
  <project name="Ingres_device_xiaomi_sm8450-common" path="device/xiaomi/sm8450-common" remote="d2n" revision="lineage-23.2" />
  <project name="android_hardware_xiaomi" path="hardware/xiaomi" remote="los" revision="lineage-23.2" />

  <!-- Vendor // ingres -->
  <project name="proprietary_vendor_xiaomi_ingres" path="vendor/xiaomi/ingres" remote="d2n" revision="lineage-24.0" clone-depth="1" />
  <!-- Vendor // common -->
  <project name="proprietary_vendor_xiaomi_sm8450-common" path="vendor/xiaomi/sm8450-common" remote="muppets" revision="lineage-23.2" clone-depth="1" />

  <!-- Kernel (5.10 GKI + driver ingres) -->
  <!-- Melt kernel (melt-MIX + driver ingres dari android_kernel_xiaomi_sm8450) -->
  <project name="kernel_source_Melt_xiaomi_ingres" path="kernel/xiaomi/sm8450" remote="d2n" revision="melt-MIX-rom" clone-depth="1" />
  <!-- Kernel module -->
  <project name="android_kernel_xiaomi_sm8450-modules" path="kernel/xiaomi/sm8450-modules" remote="los" revision="lineage-24.0" clone-depth="1" />
  <!-- Kernel device tree -->
  <project name="android_kernel_xiaomi_sm8450-devicetrees" path="kernel/xiaomi/sm8450-devicetrees" remote="d2n" revision="lineage-24.0" clone-depth="1" />

  <!-- Paket tambahan: GameKeys, LED, Dolby Lunaris, JamesDSP, MIUI Camera -->
  <remote name="gh" fetch="https://github.com" />
  <project path="vendor/ingres/addons" name="kingD2N/LED_ingres_for_Notifikasi_system" remote="gh" revision="addons" />
  <project path="vendor/xiaomi/gamekey" name="Ingres-Centre/android_vendor_xiaomi_gamekey" remote="gh" revision="master" />
  <!-- submodule GameKeys (repo tidak mengambil git submodule) -->
  <project path="vendor/xiaomi/gamekey/third_party/cpp/evdev" name="LineageOS/android_external_libevdev" remote="gh" revision="lineage-22.2" />
  <project path="hardware/dolby" name="Ghosuto/hardware_dolby" remote="gh" revision="16" />
  <project path="vendor/JamesDSP" name="MillenniumOSS/android_vendor_JamesDSP" remote="gh" revision="sixteen" clone-depth="1" />
  <project path="vendor/xiaomi/miuicamera-ingres" name="Gurinbone/android_vendor_xiaomi_miuicamera-ingres" remote="gh" revision="lineage-23.2" clone-depth="1" />
  <project path="device/xiaomi/miuicamera-ingres" name="Ingres-stuff/android_device_xiaomi_miuicamera-ingres" remote="gh" revision="lineage-21" />
</manifest>
