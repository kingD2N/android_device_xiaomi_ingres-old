<?xml version="1.0" encoding="UTF-8"?>
<!--
    ASCP 17 (Android 17, Pixelify-AOSP/platform_manifest branch 17) untuk POCO F4 GT / Redmi K50 Gaming (ingres).
    Taruh di .repo/local_manifests/ascp.xml - dipasang otomatis oleh build-ascp.sh.
    Semua repo ingres memakai branch LineageOS 24 (ASCP juga memakai repo CAF lineage-24.0).
-->
<manifest>
  <remote name="d2n" fetch="https://github.com/kingD2N" />
  <remote name="los" fetch="https://github.com/LineageOS" />
  <remote name="muppets" fetch="https://github.com/TheMuppets" />

  <!-- Device // ingres -->
  <project name="android_device_xiaomi_ingres-old" path="device/xiaomi/ingres" remote="d2n" revision="ascp-17" />
  <!-- Device // common -->
  <project name="Ingres_device_xiaomi_sm8450-common" path="device/xiaomi/sm8450-common" remote="d2n" revision="lineage-24.0" />
  <project name="android_hardware_xiaomi" path="hardware/xiaomi" remote="los" revision="lineage-24.0" />

  <!-- Vendor // ingres -->
  <project name="proprietary_vendor_xiaomi_ingres" path="vendor/xiaomi/ingres" remote="d2n" revision="lineage-24.0-a17" clone-depth="1" />
  <!-- Vendor // common -->
  <!-- A17 64-bit: vendor common Gurinbone (ssgqmigd64, entri Dolby, tabel FPS termal) -->
  <project path="vendor/xiaomi/sm8450-common" name="Gurinbone/proprietary_vendor_xiaomi_sm8450-common" remote="gh" revision="lineage-24.0" clone-depth="1" />

  <!-- Kernel -->
  <project name="android_kernel_xiaomi_sm8450" path="kernel/xiaomi/sm8450" remote="d2n" revision="lineage-24.0-a17" clone-depth="1" />
  <!-- Kernel module -->
  <project name="android_kernel_xiaomi_sm8450-modules" path="kernel/xiaomi/sm8450-modules" remote="los" revision="lineage-24.0" clone-depth="1" />
  <!-- Kernel device tree -->
  <project name="android_kernel_xiaomi_sm8450-devicetrees" path="kernel/xiaomi/sm8450-devicetrees" remote="d2n" revision="lineage-24.0" clone-depth="1" />

  <!-- Paket tambahan: GameKeys, LED, Dolby Lunaris, JamesDSP, MIUI Camera -->
  <remote name="gh" fetch="https://github.com" />
  <project path="vendor/ingres/addons" name="kingD2N/LED_ingres_for_Notifikasi_system" remote="gh" revision="addons" />
  <project path="vendor/xiaomi/gamekey" name="Ingres-Centre/android_vendor_xiaomi_gamekey" remote="gh" revision="master" />
  <!-- submodule GameKeys (repo tidak mengambil git submodule) -->
  <project path="vendor/xiaomi/gamekey/third_party/cpp/evdev" name="LineageOS/android_external_libevdev" remote="gh" revision="lineage-22.2" />
  <!-- A17: Dolby sony-A17 (aturan sepolicy platform_app_36) + aplikasi LunarisDolby dari DolbyUI -->
  <project path="hardware/dolby" name="Gurinbone/hardware_dolby" remote="gh" revision="sony-A17" />
  <project path="packages/apps/DolbyUI" name="Gurinbone/packages_apps_DolbyUI" remote="gh" revision="main" />
  <project path="vendor/JamesDSP" name="MillenniumOSS/android_vendor_JamesDSP" remote="gh" revision="sixteen" clone-depth="1" />
  <project path="vendor/xiaomi/miuicamera-ingres" name="Gurinbone/android_vendor_xiaomi_miuicamera-ingres" remote="gh" revision="lineage-23.2" clone-depth="1" />
  <project path="device/xiaomi/miuicamera-ingres" name="Gurinbone/android_device_xiaomi_miuicamera-ingres" remote="gh" revision="A17" />
</manifest>
